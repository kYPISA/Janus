set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER "${CMAKE_CURRENT_LIST_DIR}/../tools/zig-cc.cmd")
set(CMAKE_CXX_COMPILER "${CMAKE_CURRENT_LIST_DIR}/../tools/zig-cxx.cmd")
set(CMAKE_C_FLAGS_INIT "-target x86_64-macos-none")
set(CMAKE_CXX_FLAGS_INIT "-target x86_64-macos-none")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_SHARED_LIBRARY_CREATE_CXX_FLAGS "-dynamiclib")
set(CMAKE_AR "${CMAKE_CURRENT_LIST_DIR}/../tools/zig-ar.cmd" CACHE FILEPATH "Archive tool" FORCE)
set(CMAKE_RANLIB "${CMAKE_CURRENT_LIST_DIR}/../tools/zig-ranlib.cmd" CACHE FILEPATH "Archive index tool" FORCE)